ORG 0000H
START:
    MOV P1, #OFFH
    ACALL DELAY
    MOV P1, #COH
    ACALL DELAY
    SIMP START

DELAY:
    MOV R6,#5
D2: MOV R6, D2
RET

Flowing Right LED pattern
ORG 0000H
MOV A, #01H
MAIN:
    MOV P1, A
    MOV R0, #0FFH
WAIT:
    DJNZ R0, WAIT
    RR A          ; Rotate right
    SJMP MAIN
END
