; CLOCKWISE
ORG 0000H
MAIN:
    MOV P3,#00H
LOOP:
    SETB P3.1
    CLR P3.0
    ACALL DELAY

    SETB P3.0
    CLR P3.1
    ACALL DELAY

    SJMP LOOP

DELAY:
    MOV R7,#255
D1: MOV R6,#255
D2: DJNZ R6,D2
    DJNZ R7,D1
    RET

END


;ANTI CLOCK 
ORG 0000H

HAIH:
    MOV P3,#00H

LOOP:
    SETB P3.0
    CLR P3.1
    ACALL DELAY

    SETB P3.1
    CLR P3.0
    ACALL DELAY

    SJMP LOOP

DELAY:
    MOV R7,#255
D1: MOV R6,#255
D2: DJNZ R6, D2
    DJNZ R7, D1
    RET

END
